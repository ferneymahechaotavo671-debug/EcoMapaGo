# Cadena de conexión a PostgreSQL (Supabase: usa el connection string del Pooler en modo Transaction)
DATABASE_URL=postgresql://usuario:password@host:6543/postgres

# Clave secreta para firmar los JWT. OBLIGATORIA: la app no arranca sin ella.
# Genera una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Clave de cifrado para datos sensibles en reposo (el secreto de la verificación en dos pasos).
# OBLIGATORIA: la app no arranca sin ella. Genera una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=cambia_esto_por_una_clave_fernet_generada

# Solo ponlo en "true" para desarrollo local. En Render NO se define (queda en false por defecto).
FLASK_DEBUG=false
